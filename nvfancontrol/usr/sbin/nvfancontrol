#!/usr/bin/env bash

set -euo pipefail

expected_uuid='884a63a0-3285-4120-83aa-eec008a0a546'
ffa_device='/sys/bus/arm_ffa/devices/arm-ffa-17'
fan_path="$ffa_device/fan"
caps_path="$ffa_device/fan_caps"
telemetry_path="$ffa_device/fan_telemetry"
rpm_path="$ffa_device/fan_rpm"
override_path="$ffa_device/fan_override"
module='nvfancontrol'
default_log='/var/log/nvfancontrol-telemetry.csv'

usage() {
    printf 'Usage: sudo nvfancontrol {max|auto|status|unload|enable|disable|curve|telemetry [--watch] [--interval N] [--log PATH]}\n' >&2
    printf '  max        load the module if needed, then write max to the fan sysfs interface\n' >&2
    printf '  auto       load the module if needed, then write auto to the fan sysfs interface\n' >&2
    printf '  status     show whether the module is loaded and read the fan interface\n' >&2
    printf '  unload     explicitly remove the module; the EC setting remains unchanged\n' >&2
    printf '  enable     load the module if needed, then enable the nvfancontrol_ec thermal zone\n' >&2
    printf '             (kernel step_wise governor takes over both EC override slots)\n' >&2
    printf '  disable    disable the nvfancontrol_ec thermal zone (releases overrides to the EC)\n' >&2
    printf '  curve      show the thermal zone/cooling device status: mode, temp, trip points,\n' >&2
    printf '             cooling state, fan_rpm, fan_override (read-only, does not load the module)\n' >&2
    printf '  telemetry  read live EC fan telemetry and correlate it with sensors(1) temperatures\n' >&2
    printf '             --watch          keep sampling until interrupted (default: one shot)\n' >&2
    printf "             --interval N     seconds between samples in watch mode (default: 2)\n" >&2
    printf '             --log PATH       CSV log file for watch mode (default: %s)\n' "$default_log" >&2
    printf '             does not load the module and never changes fan mode\n' >&2
}

action="${1:-}"
case "$action" in
    max|auto|status|unload|telemetry|enable|disable|curve)
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac
shift || true

watch=0
interval=2
log_path="$default_log"

if [ "$action" = 'telemetry' ]; then
    while [ $# -gt 0 ]; do
        case "$1" in
            --watch)
                watch=1
                shift
                ;;
            --interval)
                interval="${2:-}"
                if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 1 ]; then
                    printf '%s\n' '--interval requires a positive integer number of seconds' >&2
                    exit 2
                fi
                shift 2
                ;;
            --log)
                log_path="${2:-}"
                if [ -z "$log_path" ]; then
                    printf '%s\n' '--log requires a path' >&2
                    exit 2
                fi
                shift 2
                ;;
            *)
                usage
                exit 2
                ;;
        esac
    done
elif [ $# -ne 0 ]; then
    usage
    exit 2
fi

module_is_loaded() {
    grep -q "^${module} " /proc/modules 2>/dev/null
}

if [ "$(id -u)" -ne 0 ]; then
    printf 'Run this command as root.\n' >&2
    exit 1
fi

exec 9>/run/lock/nvfancontrol.lock

acquire_lock() {
    if ! flock -n 9; then
        printf 'Another nvfancontrol operation is already running.\n' >&2
        return 1
    fi
}

if [ "$action" != 'telemetry' ] || [ "$watch" -eq 0 ]; then
    acquire_lock || exit 1
fi

if [ "$action" = 'unload' ]; then
    if ! module_is_loaded; then
        printf 'nvfancontrol is already unloaded.\n'
        exit 0
    fi
    rmmod "$module"
    printf 'nvfancontrol unloaded. The EC override value was not changed.\n'
    exit 0
fi

if [ ! -r "$ffa_device/uuid" ]; then
    printf 'Expected FF-A device is missing: %s\n' "$ffa_device" >&2
    exit 1
fi

actual_uuid="$(tr -d '\r\n' < "$ffa_device/uuid")"
if [ "$actual_uuid" != "$expected_uuid" ]; then
    printf 'Refusing to continue: %s has UUID %s, expected %s\n' \
        "$ffa_device" "$actual_uuid" "$expected_uuid" >&2
    exit 1
fi

if [ "$action" = 'status' ]; then
    if ! module_is_loaded; then
        printf 'Module: unloaded\n'
        printf 'Fan interface: unavailable\n'
        exit 0
    fi
    if [ ! -r "$fan_path" ]; then
        printf 'Module: loaded\n' >&2
        printf 'Fan interface is missing: %s\n' "$fan_path" >&2
        exit 1
    fi
    printf 'Module: loaded\n'
    printf 'Driver: %s\n' "$(readlink "$ffa_device/driver")"
    printf 'Fan: %s\n' "$(tr -d '\r\n' < "$fan_path")"
    exit 0
fi

sensors_temps() {
    if ! command -v sensors >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        printf 'unavailable(sensors-or-jq-missing)'
        return 0
    fi
    sensors -j 2>/dev/null | jq -r '
        to_entries[] | .key as $chip | .value
        | to_entries[] | select(.value | type == "object")
        | .key as $label | .value
        | to_entries[] | select(.key | test("_input$"))
        | "\($chip)/\($label)=\(.value)"
    ' 2>/dev/null | paste -sd';' - 2>/dev/null || printf 'unavailable(sensors-read-failed)'
}

sample_telemetry() {
    local ts fan_mode rpm override telemetry_hex temps

    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fan_mode="$(tr -d '\r\n' < "$fan_path")"
    rpm="$(tr -d '\r\n' < "$rpm_path")"
    override="$(tr -d '\r\n' < "$override_path" 2>/dev/null || printf 'unavailable')"
    telemetry_hex="$(tr -d '\r\n' < "$telemetry_path")"
    temps="$(sensors_temps)"

    printf '%s fan=%s %s override=%s temps=%s telemetry=%s\n' \
        "$ts" "$fan_mode" "$rpm" "$override" "$temps" "$telemetry_hex"

    if [ "$watch" -eq 1 ]; then
        if [ ! -s "$log_path" ]; then
            printf 'timestamp,fan_mode,fan0_rpm,fan1_rpm,override,temps,telemetry_hex\n' > "$log_path"
        fi
        printf '%s,%s,%s,%s,"%s","%s",%s\n' "$ts" "$fan_mode" \
            "$(printf '%s' "$rpm" | grep -oP 'fan0_rpm=\K[0-9]+')" \
            "$(printf '%s' "$rpm" | grep -oP 'fan1_rpm=\K[0-9]+')" \
            "$override" "$temps" "$telemetry_hex" >> "$log_path"
    fi
}

if [ "$action" = 'telemetry' ]; then
    if ! module_is_loaded; then
        printf 'nvfancontrol module is not loaded; run "sudo nvfancontrol max" or "auto" first.\n' >&2
        exit 1
    fi
    if [ ! -r "$fan_path" ] || [ ! -r "$telemetry_path" ] || [ ! -r "$rpm_path" ]; then
        printf 'Fan telemetry interface is missing: %s\n' "$telemetry_path" >&2
        exit 1
    fi

    if [ -r "$caps_path" ]; then
        printf 'caps=%s\n' "$(tr -d '\r\n' < "$caps_path")"
    fi

    if [ "$watch" -eq 0 ]; then
        sample_telemetry
        exit 0
    fi

    printf 'Watching every %ss, logging to %s. Press Ctrl-C to stop.\n' "$interval" "$log_path" >&2
    while true; do
        if acquire_lock; then
            sample_telemetry
            flock -u 9
        else
            printf 'skipped sample: lock busy\n' >&2
        fi
        sleep "$interval"
    done
fi

load_module_if_needed() {
    if module_is_loaded; then
        return 0
    fi

    if [ -L "$ffa_device/driver" ]; then
        printf 'Refusing to continue: %s is already bound to %s\n' \
            "$ffa_device" "$(readlink "$ffa_device/driver")" >&2
        exit 1
    fi

    kernel_release="$(uname -r)"
    module_path="$(modinfo -n "$module" 2>/dev/null || true)"
    if [ -z "$module_path" ] || [ ! -r "$module_path" ]; then
        printf 'nvfancontrol module is not installed for the running kernel %s.\n' \
            "$kernel_release" >&2
        printf 'Install matching headers, then reinstall or reconfigure the package.\n' >&2
        exit 1
    fi

    module_name="$(modinfo -F name "$module_path")"
    module_vermagic="$(modinfo -F vermagic "$module_path")"
    if [ "$module_name" != "$module" ]; then
        printf 'Refusing unexpected module name %s in %s\n' "$module_name" "$module_path" >&2
        exit 1
    fi
    case "$module_vermagic" in
        "$kernel_release "*)
            ;;
        *)
            printf 'Module vermagic does not match the running kernel: %s\n' "$module_vermagic" >&2
            exit 1
            ;;
    esac

    insmod "$module_path"

    for _ in {1..50}; do
        if [ -e "$fan_path" ]; then
            break
        fi
        sleep 0.1
    done

    if [ ! -e "$fan_path" ]; then
        printf 'Module loaded but the fan sysfs interface was not created.\n' >&2
        rmmod "$module" || true
        exit 1
    fi
}

# Finds the nvfancontrol_ec thermal zone and nvfancontrol_fan cooling device
# by scanning sysfs type files, since their thermal_zoneN/cooling_deviceN
# index depends on how many other zones/cdevs are already registered.
# Sets zone_path/cdev_path (empty if not found); safe under `set -e`.
find_zone_cdev() {
    zone_path=""
    cdev_path=""
    for t in /sys/class/thermal/thermal_zone*; do
        if [ -r "$t/type" ] && [ "$(cat "$t/type" 2>/dev/null)" = "nvfancontrol_ec" ]; then
            zone_path="$t"
        fi
    done
    for t in /sys/class/thermal/cooling_device*; do
        if [ -r "$t/type" ] && [ "$(cat "$t/type" 2>/dev/null)" = "nvfancontrol_fan" ]; then
            cdev_path="$t"
        fi
    done
}

if [ "$action" = 'enable' ]; then
    load_module_if_needed
    find_zone_cdev
    if [ -z "$zone_path" ]; then
        printf 'nvfancontrol_ec thermal zone not found under /sys/class/thermal/\n' >&2
        exit 1
    fi
    current_mode="$(tr -d '\r\n' < "$zone_path/mode")"
    if [ "$current_mode" = 'enabled' ]; then
        printf 'Already enabled.\n'
        exit 0
    fi
    echo enabled > "$zone_path/mode"
    after="$(tr -d '\r\n' < "$zone_path/mode")"
    if [ "$after" != 'enabled' ]; then
        printf 'Unexpected mode after write: expected enabled, observed %s\n' "$after" >&2
        exit 1
    fi
    printf 'OK: %s enabled. Kernel governor now owns both EC override slots.\n' "$zone_path"
    exit 0
fi

if [ "$action" = 'disable' ]; then
    if ! module_is_loaded; then
        printf 'nvfancontrol module is not loaded; nothing to disable.\n'
        exit 0
    fi
    find_zone_cdev
    if [ -z "$zone_path" ]; then
        printf 'nvfancontrol_ec thermal zone not found under /sys/class/thermal/\n' >&2
        exit 1
    fi
    current_mode="$(tr -d '\r\n' < "$zone_path/mode")"
    if [ "$current_mode" = 'disabled' ]; then
        printf 'Already disabled.\n'
        exit 0
    fi
    echo disabled > "$zone_path/mode"
    after="$(tr -d '\r\n' < "$zone_path/mode")"
    if [ "$after" != 'disabled' ]; then
        printf 'Unexpected mode after write: expected disabled, observed %s\n' "$after" >&2
        exit 1
    fi
    printf 'OK: %s disabled. Overrides released back to the EC (0xffff/0xffff).\n' "$zone_path"
    exit 0
fi

if [ "$action" = 'curve' ]; then
    if ! module_is_loaded; then
        printf 'Module: unloaded\n'
        exit 0
    fi
    find_zone_cdev
    if [ -z "$zone_path" ] || [ -z "$cdev_path" ]; then
        printf 'nvfancontrol_ec zone or nvfancontrol_fan cdev not found under /sys/class/thermal/\n' >&2
        exit 1
    fi
    printf 'zone: %s\n' "$zone_path"
    printf 'cooling device: %s\n' "$cdev_path"
    printf 'mode: %s\n' "$(tr -d '\r\n' < "$zone_path/mode")"
    printf 'temp: %s mC\n' "$(tr -d '\r\n' < "$zone_path/temp" 2>/dev/null || printf 'unavailable')"
    n=0
    while [ -r "$zone_path/trip_point_${n}_temp" ]; do
        printf 'trip%d: temp=%s hyst=%s\n' "$n" \
            "$(tr -d '\r\n' < "$zone_path/trip_point_${n}_temp")" \
            "$(tr -d '\r\n' < "$zone_path/trip_point_${n}_hyst" 2>/dev/null || printf '?')"
        n=$((n + 1))
    done
    printf 'cooling state: %s / %s (max)\n' \
        "$(tr -d '\r\n' < "$cdev_path/cur_state")" \
        "$(tr -d '\r\n' < "$cdev_path/max_state")"
    if [ -r "$rpm_path" ]; then
        printf 'fan_rpm: %s\n' "$(tr -d '\r\n' < "$rpm_path")"
    fi
    if [ -r "$override_path" ]; then
        printf 'fan_override: %s\n' "$(tr -d '\r\n' < "$override_path")"
    fi
    exit 0
fi

if [ "$action" = 'max' ] || [ "$action" = 'auto' ]; then
    load_module_if_needed

    if [ ! -L "$ffa_device/driver" ] ||
            [ "$(basename "$(readlink "$ffa_device/driver")")" != "$module" ]; then
        printf 'Refusing to write: %s is not bound to the nvfancontrol driver.\n' \
            "$ffa_device" >&2
        exit 1
    fi

    if [ ! -w "$fan_path" ]; then
        printf 'Fan interface is not writable: %s\n' "$fan_path" >&2
        exit 1
    fi

    find_zone_cdev
    if [ -n "$zone_path" ] && [ "$(tr -d '\r\n' < "$zone_path/mode" 2>/dev/null)" = 'enabled' ]; then
        printf 'Refusing to write: the nvfancontrol_ec thermal zone is enabled and owns both override slots.\n' >&2
        printf 'Run "sudo nvfancontrol disable" first, or use "sudo nvfancontrol curve" to inspect it.\n' >&2
        exit 1
    fi

    if ! printf '%s\n' "$action" > "$fan_path"; then
        printf 'The sysfs write failed; EC override state is unknown. Do not retry blindly.\n' >&2
        printf 'Fan state: %s\n' "$(tr -d '\r\n' < "$fan_path")" >&2
        exit 1
    fi

    after="$(tr -d '\r\n' < "$fan_path")"
    if [ "$after" != "$action" ]; then
        printf 'Unexpected fan state after write: expected %s, observed %s\n' \
            "$action" "$after" >&2
        exit 1
    fi

    printf 'OK\n'
fi
